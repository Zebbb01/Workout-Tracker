# Copy to .env and fill in. Never commit .env.

# Supabase project: Project Settings > API (the publishable key is public by design;
# Row Level Security protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Meal estimates: a Gemini API key from aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
